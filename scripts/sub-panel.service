[Unit]
Description=Sub-Panel - V2Board 订阅前置网关
Documentation=https://github.com/huabanmao168-one/Sub-Panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/Sub-Panel
UMask=0077
PrivateTmp=yes
# Existing databases may still point at the legacy /tmp location.
ExecStartPre=/bin/sh -c 'if test -f /opt/Sub-Panel/ip2region.xdb; then mkdir -p /tmp/sub-panel; ln -sfn /opt/Sub-Panel/ip2region.xdb /tmp/sub-panel/ip2region.xdb; fi'
ExecStart=/opt/Sub-Panel/sub-panel
Restart=on-failure
RestartSec=3s
LimitNOFILE=65536
# 日志走 journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
